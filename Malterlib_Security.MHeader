Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Security}"
{
	%Group "Security"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Security/^*"
		}
		%File "Source/*"
		%Group "Platform"
		{
			%File "Source/Platform/*"
			{
				Compile.Disabled true
				{
					!PlatformFamily PlatformFamilyFromFile
				}
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}

Property
{
	MalterlibLibrary_Security define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Security"
	{
		!!MalterlibLibrary_Security true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Security define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Security true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Security"
	MalterlibTestFiles_Malterlib_Security define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}
